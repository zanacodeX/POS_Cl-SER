{
  "name": "pixel-art-pos-client",
  "version": "2.0.0",
  "description": "Pixel Art POS - Client (connects to a server)",
  "main": "electron-main.js",
  "scripts": {
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.pixelart.pos.client",
    "productName": "Pixel Art POS Client",
    "directories": {
      "output": "..\\dist-client"
    },
    "files": [
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "..\\icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "Zana Codex Creation | Contact: 0767714341",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  }
}
