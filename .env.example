# ─── Database ───────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_system

# ─── License (always-online mode) ───────
# Leave empty for first-run activation prompt (recommended).
# Set here only if building a per-company installer.
PRODUCT_KEY=
LICENSE_API_URL=https://YOUR-DOMAIN.infinityfreeapp.com/api

# ─── Auth ───────────────────────────────
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=24h

# ─── Server ─────────────────────────────
PORT=3000
# Set to "true" during development to skip product key validation
SKIP_LICENSE=false
